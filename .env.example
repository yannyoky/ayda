# Copy to .env for local development. Never commit real values.
# Production values live in GitHub secrets and on the VPS.

# Backend
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://ayda:ayda@localhost:5432/ayda
# Backend tests (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://ayda:ayda@localhost:5432/ayda_test

# Local docker compose
POSTGRES_PASSWORD=ayda
CENTRIFUGO_TOKEN_SECRET=change-me
CENTRIFUGO_API_KEY=change-me

# Telegram bot (@BotFather) and API tokens
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ayda_quest_bot
AUTH_TOKEN_SECRET=
# Mini App URL for bot buttons (optional); webhook for production (empty: polling)
MINIAPP_URL=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
BOT_PORT=8081

# LLM providers in fallback order (presets in backend/src/ayda/modules/assistant/providers.py),
# default chain from ADR 0005 (put cloudflare-llama70b first if Groq is unreachable; ollama
# for local dev). Empty: code-only ranking.
LLM_PROVIDERS=groq-gptoss20b,groq-gptoss120b,cloudflare-llama70b
LLM_TIMEOUT_S=8
GROQ_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=
OLLAMA_URL=http://localhost:11434/v1

# S3-compatible photo storage in Russia (local dev: MinIO from docker-compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=ru-central1
S3_BUCKET=ayda-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Daily database backup to a private bucket of the same S3 provider
BACKUP_BUCKET=ayda-backups
# Keys of the backup bucket when the provider issues a key pair per bucket (Beget); empty: the S3 keys
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14

# Push notifications (FCM HTTP v1): the Firebase service-account JSON on one line; empty: off
FCM_SERVICE_ACCOUNT_JSON=

# Email sign-in codes for the native apps (ADR 0009); without SMTP_HOST email sign-in is off.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Ayda <noreply@example.ru>

# Error tracking (self-hosted GlitchTip DSN); empty: off
SENTRY_DSN=

# Local events (ADR 0008): sources in order; empty: no events. Timepad requires a token (dev.timepad.ru, scope view_events).
EVENTS_SOURCES=timepad,kudago
TIMEPAD_TOKEN=
