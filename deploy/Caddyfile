# Baked into the ayda-web image together with the Mini App build (deploy/web.Dockerfile).
# No access log: request lines can carry personal data.
{
	email {$ACME_EMAIL}
}

{$AYDA_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /telegram/webhook {
		reverse_proxy bot:8081
	}
	# Invite links (US-12): with the Android app installed the system opens the app itself (App Links);
	# everyone else lands in the bot, where the Mini App accepts the invite.
	handle /i/* {
		redir https://t.me/{$TELEGRAM_BOT_USERNAME}?startapp={http.request.uri.path.1} 302
	}
	# After a native sign-in confirmed in the Mini App (ADR 0009) Telegram opens this link and Android hands it to the app.
	# Without a verified App Link it lands here: the button opens the app by package name.
	# The page must never echo the request path: Caddy decodes it, so it would be reflected XSS (audit K1).
	handle /app/* {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta name="viewport" content="width=device-width"><title>Ayda</title><body style="font-family:sans-serif;text-align:center;padding:48px 16px"><p>Вход подтверждён.</p><p><a href="intent://{host}/app/signed-in#Intent;scheme=https;package=app.ayda;end" style="display:inline-block;padding:14px 24px;border-radius:16px;background:#FF5FA2;color:#fff;text-decoration:none">Открыть Ayda</a></p></body>` 200
	}
	handle /.well-known/assetlinks.json {
		header Content-Type application/json
		respond `[{"relation":["delegate_permission/common/handle_all_urls"],"target":{"namespace":"android_app","package_name":"app.ayda","sha256_cert_fingerprints":["{$ANDROID_CERT_SHA256}"]}}]` 200
	}
	handle /connection/* {
		reverse_proxy centrifugo:8000
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

{$ERRORS_DOMAIN} {
	encode zstd gzip
	reverse_proxy glitchtip:8000
}
