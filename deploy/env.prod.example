# /opt/ayda/.env on the VPS (chmod 600). Never commit real values.
# Generate secrets with: openssl rand -base64 32

# Domains (A records point to the VPS)
AYDA_DOMAIN=
ERRORS_DOMAIN=
ACME_EMAIL=

# SHA-256 fingerprint of the Android app's signing certificate (AA:BB:...), for invite App Links;
# empty: links open in the browser and the bot instead of the app
ANDROID_CERT_SHA256=

POSTGRES_PASSWORD=
AUTH_TOKEN_SECRET=

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ayda_quest_bot
# required: the bot refuses to start without it, e.g. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=

# LLM chain from ADR 0005
LLM_PROVIDERS=groq-gptoss20b,groq-gptoss120b,cloudflare-llama70b
GROQ_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# S3-compatible storage of a Russian provider: photos and database backups
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=ru-central1
S3_BUCKET=ayda-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_BUCKET=ayda-backups
# Keys of the backup bucket when the provider issues a key pair per bucket (Beget); empty: the S3 keys
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14

# Push notifications (FCM HTTP v1): the Firebase service-account JSON on one line; empty: off
FCM_SERVICE_ACCOUNT_JSON=

# Email sign-in codes for the native apps (ADR 0009); without SMTP_HOST email sign-in is off.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Ayda <noreply@example.ru>

# Error tracking: DSN of the "ayda" project created in GlitchTip
SENTRY_DSN=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# Local events (M3, ADR 0008); Timepad requires a token (dev.timepad.ru, scope view_events)
EVENTS_SOURCES=timepad,kudago
TIMEPAD_TOKEN=

# Venues for meetups (M5, ADR 0011): public Overpass instances in order; empty turns them off
VENUES_OVERPASS_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter

# Realtime (M2)
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_API_KEY=
